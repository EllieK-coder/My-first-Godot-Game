[gd_scene load_steps=3 format=3 uid="uid://1n1gs3xoj3sd"]

[ext_resource type="PackedScene" uid="uid://crun2rpi0ttmi" path="res://volumeslider.tscn" id="1_gtb43"]

[sub_resource type="GDScript" id="GDScript_vsb4k"]
script/source = "extends Control
@onready var audio = $MarginContainer/VBoxContainer/volume
var volume
var value = 0

func _on_back_pressed() -> void:
			get_tree().change_scene_to_file(\"res://menu.tscn\")


func _on_volume_value_changed(value: float) -> void:
	pass # Replace with function body.



func _on_volume_drag_ended(value_changed: bool) -> void:
	_volume(0, value)



func _on_volume_drag_started() -> void:
	pass # Replace with function body.



@export
var bus_name: String

var bus_index: int

func _ready() -> void:
	bus_index = AudioServer.get_bus_index(bus_name)


	
	
func _volume(bus_index, value):
	AudioServer.set_bus_volume_db(
		bus_index,
		linear_to_db(value)
		)

	
"

